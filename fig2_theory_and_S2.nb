Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Solving", " ", "for", " ", "the", " ", "delta"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", " ", "=", " ", "1.4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", " ", "=", " ", "0.8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"start", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"1", "/", "r"}]}], ")"}], "^", "2"}], " ", "+", "0.1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 FractionBox["1", "r"]}], ")"}], "2"], 
              RowBox[{"2", " ", "q", " ", 
               SuperscriptBox["sigma", "2"]}]]}]], " ", 
           SqrtBox["q"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r", " ", "sigma"}], 
          "-", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox["1", 
              RowBox[{"2", " ", "q", " ", 
               SuperscriptBox["r", "2"], " ", 
               SuperscriptBox["sigma", "2"]}]]}]], " ", 
           SqrtBox["q"], " ", "r", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"2", " ", "r"}]}], ")"}], " ", "sigma"}], "-", 
          RowBox[{
           SqrtBox[
            FractionBox["\[Pi]", "2"]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"r", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "r", "+", 
                RowBox[{"q", " ", "r", " ", 
                 SuperscriptBox["sigma", "2"]}]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Erf", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              FractionBox["1", "r"]}], 
             RowBox[{
              SqrtBox["2"], " ", 
              SqrtBox["q"], " ", "sigma"}]], "]"}]}], "+", 
          RowBox[{
           SqrtBox[
            FractionBox["\[Pi]", "2"]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"r", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "r", "+", 
                RowBox[{"q", " ", "r", " ", 
                 SuperscriptBox["sigma", "2"]}]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Erf", "[", 
            FractionBox["1", 
             RowBox[{
              SqrtBox["2"], " ", 
              SqrtBox["q"], " ", "r", " ", "sigma"}]], "]"}]}]}], 
         RowBox[{
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]], " ", 
          SuperscriptBox["r", "2"]}]], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"Erfc", "[", 
          FractionBox["1", 
           RowBox[{
            SqrtBox["2"], " ", 
            SqrtBox["q"], " ", "r", " ", "sigma"}]], "]"}]}]}], "\[Equal]", 
       "q"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "start"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"q0", " ", "=", " ", 
    RowBox[{"q", "/.", "sol"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", "Pi", " ", "q0", " ", 
        RowBox[{"sigma", "^", "2"}]}], "]"}]}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"1", "/", "r"}]}], ")"}]}], ")"}], "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"sigma", "^", "2"}], "q0"}], ")"}]}], "]"}], 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"1", "-", "x"}], "]"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", "2"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmin", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmax", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numx", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvec", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xmin", ",", "xmax", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numx", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"histvec", " ", "=", " ", 
   RowBox[{"f", "[", "xvec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"xvec", ",", "histvec"}], "}"}], "]"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
