Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", " ", "=", "1.4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", " ", "=", "0.8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"start", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"1", "/", "r"}]}], ")"}], "^", "2"}], "+", "0.1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 FractionBox["1", "r"]}], ")"}], "2"], 
              RowBox[{"2", " ", "q", " ", 
               SuperscriptBox["sigma", "2"]}]]}]], " ", 
           SqrtBox["q"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r", " ", "sigma"}], 
          "-", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox["1", 
              RowBox[{"2", " ", "q", " ", 
               SuperscriptBox["r", "2"], " ", 
               SuperscriptBox["sigma", "2"]}]]}]], " ", 
           SqrtBox["q"], " ", "r", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"2", " ", "r"}]}], ")"}], " ", "sigma"}], "-", 
          RowBox[{
           SqrtBox[
            FractionBox["\[Pi]", "2"]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"r", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "r", "+", 
                RowBox[{"q", " ", "r", " ", 
                 SuperscriptBox["sigma", "2"]}]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Erf", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              FractionBox["1", "r"]}], 
             RowBox[{
              SqrtBox["2"], " ", 
              SqrtBox["q"], " ", "sigma"}]], "]"}]}], "+", 
          RowBox[{
           SqrtBox[
            FractionBox["\[Pi]", "2"]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"r", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "r", "+", 
                RowBox[{"q", " ", "r", " ", 
                 SuperscriptBox["sigma", "2"]}]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Erf", "[", 
            FractionBox["1", 
             RowBox[{
              SqrtBox["2"], " ", 
              SqrtBox["q"], " ", "r", " ", "sigma"}]], "]"}]}]}], 
         RowBox[{
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]], " ", 
          SuperscriptBox["r", "2"]}]], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"Erfc", "[", 
          FractionBox["1", 
           RowBox[{
            SqrtBox["2"], " ", 
            SqrtBox["q"], " ", "r", " ", "sigma"}]], "]"}]}]}], "\[Equal]", 
       "q"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "start"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"q0", " ", "=", " ", 
    RowBox[{"q", "/.", "sol"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", " ", "=", " ", "0.001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numom", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ommin", " ", "=", " ", 
    RowBox[{"-", "0.99"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ommax", " ", "=", " ", 
   RowBox[{"1", "-", "r", "-", "eps"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"omvec", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"myom", ",", 
     RowBox[{"{", 
      RowBox[{"myom", ",", " ", "ommin", ",", " ", "ommax", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ommax", " ", "-", " ", "ommin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numom", " ", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fvec", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"myom", ",", " ", "ommin", ",", " ", "ommax", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ommax", " ", "-", " ", "ommin"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"numom", " ", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"j", "=", " ", "1"}], ",", " ", 
    RowBox[{"j", "<", 
     RowBox[{"numom", "+", "1"}]}], ",", " ", 
    RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"om", "=", " ", 
      RowBox[{"omvec", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fvec", "[", 
       RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sigma", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"myx", "-", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"1", "/", "r"}]}], " ", ")"}]}], ")"}], "^", 
              "2"}]}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"sigma", "^", "2"}], " ", "q0"}], ")"}]}], "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"sigma", "^", "2"}], " ", "q0"}], "]"}]}], " ", 
         RowBox[{"r", "^", "2"}], 
         RowBox[{
          RowBox[{"myx", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"r", " ", "myx"}], " ", "-", " ", "om"}], ")"}], "^", 
            "2"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"myx", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
     ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nearest", " ", "=", " ", 
   RowBox[{
    RowBox[{"Nearest", "[", 
     RowBox[{"fvec", ",", "1"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pos", " ", "=", " ", 
   RowBox[{
    RowBox[{"Position", "[", 
     RowBox[{"fvec", ",", " ", "nearest"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"critom", "=", " ", 
    RowBox[{"omvec", "[", 
     RowBox[{"[", "pos", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmin", " ", "=", " ", 
   RowBox[{"critom", "-", "0.001"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmax", " ", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numx", " ", "=", " ", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvec", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"s", ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "xmin", ",", " ", "xmax", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numx", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crityvec", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"s", ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "xmin", ",", " ", "xmax", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numx", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crityvecapprox", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"s", ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "xmin", ",", " ", "xmax", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numx", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numy", " ", "=", " ", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ymin", " ", "=", " ", "0"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ymax", " ", "=", "0.55"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yvec", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{"y", ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "ymin", ",", " ", "ymax", ",", " ", 
        RowBox[{
         RowBox[{"(", 
