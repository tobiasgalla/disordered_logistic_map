  "In[2374]:=",ExpressionUUID->"b5e5434c-ac46-4c57-b078-ba067f0d0fdc"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SqrtBox["q0"], " ", "sigma", " ", 
      RowBox[{"(", 
        RowBox[{
          RowBox[{
            SqrtBox["q0"], " ", 
            SqrtBox[
             FractionBox["1", 
              RowBox[{"q0", " ", 
                SuperscriptBox["sigma", "2"]}]]], " ", "sigma"}], "+", 
          RowBox[{"Erf", "[", 
            FractionBox[
             RowBox[{
               RowBox[{"-", "3"}], "+", "r", "+", 
               RowBox[{"m0", " ", "mu", " ", "r"}]}], 
             RowBox[{
               SqrtBox["2"], " ", 
               SqrtBox["q0"], " ", "r", " ", "sigma"}]], "]"}]}], ")"}]}], 
    RowBox[{"2", " ", 
      SqrtBox[
       RowBox[{"q0", " ", 
         SuperscriptBox["sigma", "2"]}]]}]], 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", 
       StyleBox[
        TagBox[
         TooltipBox["\"condition\"", 
          TagBox[
           RowBox[{
