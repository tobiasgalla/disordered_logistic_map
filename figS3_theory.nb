               RowBox[{"Sqrt", "[", "2.0", "]"}]}], "]"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"w1", " ", "=", " ", 
          RowBox[{"0.5", " ", 
