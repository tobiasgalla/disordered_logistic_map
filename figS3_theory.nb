          RowBox[{
           RowBox[{"{", "mydelta", "}"}], " ", "/.", "sol"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"w0", " ", "=", " ", 
          RowBox[{"0.5", 
