Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"Integrate", "[", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"myx", "-", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"1", "/", "r"}], " ", "+", 
             RowBox[{"mu", " ", "m0"}]}], ")"}]}], ")"}], "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"sigma", "^", "2"}], " ", "q0"}], ")"}]}], "]"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"sigma", "^", "2"}], " ", "q0"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"myx", ",", 
      RowBox[{"2", "/", "r"}], ",", "Infinity"}], " ", "}"}]}], 
   "]"}]}]], "Input",
