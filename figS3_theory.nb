 RowBox[{
  RowBox[{"eps", " ", "=", " ", "0.0000001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", " ", "1"}], ",", " ", 
