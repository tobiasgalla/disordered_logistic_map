         RowBox[{"sigmamax", "-", "sigmamin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numsigma", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fvec", " ", "=", " ", 
