                    RowBox[{"0.5", 
                    RowBox[{"(", 
                    RowBox[{"1.0", " ", "+", " ", 
                    RowBox[{"Erf", "[", 
                    RowBox[{"mydelta", "/", 
                    RowBox[{"Sqrt", "[", "2.0", "]"}]}], "]"}]}], ")"}]}], 
                    ")"}]}], " ", "+", " ", 
                  RowBox[{"mydelta", " ", 
                   RowBox[{"(", " ", 
                    RowBox[{"0.5", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"2.0", "/", "Pi"}], "]"}], 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"mydelta", "^", "2"}]}], "/", "2.0"}], "]"}]}], 
                    "+", " ", 
                    RowBox[{"mydelta", " ", 
                    RowBox[{"(", 
                    RowBox[{"1.0", " ", "+", " ", 
                    RowBox[{"Erf", "[", 
                    RowBox[{"mydelta", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ")"}]}]}], 
                    ")"}]}], ")"}]}]}], ")"}], "^", "2"}]}], "\[Equal]", 
              RowBox[{"(", " ", 
               RowBox[{
                RowBox[{"(", " ", 
                 RowBox[{"0.5", 
                  RowBox[{"(", 
                   RowBox[{"1.0", " ", "+", " ", 
                    RowBox[{"Erf", "[", 
                    RowBox[{"mydelta", "/", 
                    RowBox[{"Sqrt", "[", "2.0", "]"}]}], "]"}]}], ")"}]}], 
                 ")"}], " ", "+", " ", 
                RowBox[{"mydelta", " ", 
                 RowBox[{"(", " ", 
                  RowBox[{"0.5", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"2.0", "/", "Pi"}], "]"}], 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"mydelta", "^", "2"}]}], "/", "2.0"}], "]"}]}], 
                    "+", " ", 
                    RowBox[{"mydelta", " ", 
                    RowBox[{"(", 
                    RowBox[{"1.0", " ", "+", " ", 
                    RowBox[{"Erf", "[", 
                    RowBox[{"mydelta", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ")"}]}]}], 
                    ")"}]}], ")"}]}]}], ")"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"mydelta", ",", " ", "start"}], "}"}]}], "]"}]}], ";", 
