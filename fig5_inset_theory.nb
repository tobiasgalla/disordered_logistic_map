Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", " ", "=", " ", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", " ", "=", " ", 
   RowBox[{"Sqrt", "[", "0.3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"start", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", "r"}]}], ")"}], "^", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"-", 
              FractionBox[
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", 
                  FractionBox["1", "r"]}], ")"}], "2"], 
               RowBox[{"2", " ", "q"}]]}]]}], " ", 
           SqrtBox["q"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "sigma"}], ")"}], " ", "sigma"}], "-", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox["1", 
              RowBox[{"2", " ", "q", " ", 
               SuperscriptBox["r", "2"]}]]}]], " ", 
           SqrtBox["q"], " ", "r", " ", "sigma", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", 
             RowBox[{"2", " ", "r"}], "+", "sigma"}], ")"}]}], "-", 
          RowBox[{
           SqrtBox[
            FractionBox["\[Pi]", "2"]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"r", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "r", "+", 
                RowBox[{"q", " ", "r", " ", 
                 SuperscriptBox["sigma", "2"]}]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Erf", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              FractionBox["1", "r"]}], 
             RowBox[{
              SqrtBox["2"], " ", 
              SqrtBox["q"]}]], "]"}]}], "+", 
          RowBox[{
           SqrtBox[
            FractionBox["\[Pi]", "2"]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"r", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "r", "+", 
                RowBox[{"q", " ", "r", " ", 
                 SuperscriptBox["sigma", "2"]}]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Erf", "[", 
            FractionBox["1", 
             RowBox[{
              SqrtBox["2"], " ", 
              SqrtBox["q"], " ", "r"}]], "]"}]}]}], 
         RowBox[{
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]], " ", 
          SuperscriptBox["r", "2"]}]], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"Erfc", "[", 
          FractionBox["1", 
           RowBox[{
            SqrtBox["2"], " ", 
            SqrtBox["q"], " ", "r"}]], "]"}]}]}], "\[Equal]", "q"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "start"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"q0", " ", "=", " ", 
    RowBox[{"q", "/.", "sol"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"px", "[", "x_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", "Pi", " ", 
        RowBox[{"sigma", "^", "2"}], 
        RowBox[{"r", "^", "2"}], "q0"}], "]"}]}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", "2", "+", "r"}], ")"}], "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"sigma", "^", "2"}], " ", 
         RowBox[{"r", "^", "2"}], "q0"}], ")"}]}], "]"}], 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"x", "-", 
       RowBox[{"(", 
        RowBox[{"1", "-", "r"}], ")"}]}], "]"}]}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plt1", "  ", "=", " ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"px", "[", "x_", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmin", " ", "=", " ", 
   RowBox[{"-", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmax", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numx", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvec", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xmin", ",", "xmax", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numx", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"histvec", " ", "=", " ", 
   RowBox[{"px", "[", "xvec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plt2", " ", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xvec", ",", "histvec"}], "}"}], "]"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"plt1", ",", "plt2"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<diaghistvecth.csv\>\"", ",", 
   RowBox[{"N", "[", "histvec", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<diagxvecth.csv\>\"", ",", 
   RowBox[{"N", "[", "xvec", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9527687910768642`*^9, 3.952768924888096*^9}, {
