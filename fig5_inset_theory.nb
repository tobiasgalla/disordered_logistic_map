Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", " ", "=", " ", "3.4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", " ", "=", " ", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", " ", "=", " ", "0.6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startq", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"1", "/", "r"}]}], ")"}], "^", "2"}], "+", "0.5"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startm", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", "r"}]}], ")"}], "+", "0.1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", " ", "=", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{
           SqrtBox["q"], " ", "sigma", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SqrtBox["q"], " ", 
              SqrtBox[
               FractionBox[
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "mu"}], ")"}], "2"], 
                RowBox[{"q", " ", 
                 SuperscriptBox["sigma", "2"]}]]], " ", "sigma"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "mu"}], ")"}], " ", 
              RowBox[{"Erf", "[", 
               FractionBox[
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", "m"}], ")"}], " ", "mu", " ", 
                  "r"}]}], 
                RowBox[{
                 SqrtBox["2"], " ", 
                 SqrtBox["q"], " ", "r", " ", "sigma"}]], "]"}]}]}], ")"}]}], 
          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "mu"}], ")"}], "2"], " ", 
           SqrtBox[
            FractionBox[
             RowBox[{"q", " ", 
              SuperscriptBox["sigma", "2"]}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "mu"}], ")"}], "2"]]]}]], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", "mu"}], ")"}], "3"], " ", 
            SqrtBox[
             RowBox[{"2", " ", "\[Pi]"}]], " ", 
            SuperscriptBox["r", "2"], " ", 
            SqrtBox[
             FractionBox[
              RowBox[{"q", " ", 
               SuperscriptBox["sigma", "2"]}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "mu"}], ")"}], "2"]]]}]], 
          SqrtBox["q"], " ", "sigma", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"-", 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{
                    RowBox[{"(", 
