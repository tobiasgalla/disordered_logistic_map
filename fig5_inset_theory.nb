               RowBox[{"1", "/", "r"}], " ", "-", 
               RowBox[{"mu", " ", "m0"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", "-", "mu"}], ")"}]}]}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"sigma", "^", "2"}], " ", 
          RowBox[{"q0", "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "mu"}], ")"}], "^", "2"}]}]}], ")"}]}], "]"}], 
      "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"sigma", "^", "2"}], " ", 
        RowBox[{"q0", "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "mu"}], ")"}], "^", "2"}]}]}], "]"}]}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"myx", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"xmin", " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"phi", " ", 
      RowBox[{"sigma", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmax", " ", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"phi", " ", 
     RowBox[{"sigma", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numx", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvec", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"s", ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "xmin", ",", " ", "xmax", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"numx", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yvecellipse", " ", "=", " ", 
