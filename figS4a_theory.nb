      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Pi", " ", 
         RowBox[{
          RowBox[{"Abs", "[", " ", "w", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "r", " ", "phi"}], ")"}]}], 
         RowBox[{"f", "[", "0", "]"}]}], "-", 
        RowBox[{"phi", " ", 
         RowBox[{"sigma", "^", "2"}]}]}], " ", ")"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
