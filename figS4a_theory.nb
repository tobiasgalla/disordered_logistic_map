          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "w"}], "]"}], "-", "1"}], "]"}], "^", "2"}]}]}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
